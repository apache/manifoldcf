        <outputDirectory>connector-common-lib</outputDirectory>
        <unpack>false</unpack>
        <includeDependencies>false</includeDependencies>
        <outputFileNameMapping>${artifact.artifactId}.${artifact.extension}</outputFileNameMapping>
      </binaries>
    </moduleSet>
    
    <moduleSet>
      <useAllReactorProjects>true</useAllReactorProjects>
      <includes>
        <include>org.apache.manifoldcf:mcf-*-connector</include>
      </includes>
      <binaries>
        <outputDirectory>connector-lib</outputDirectory>
        <unpack>false</unpack>
        <includeDependencies>false</includeDependencies>
        <outputFileNameMapping>${artifact.artifactId}.${artifact.extension}</outputFileNameMapping>
      </binaries>
    </moduleSet>

    <moduleSet>
      <useAllReactorProjects>true</useAllReactorProjects>
      <includes>
        <include>org.apache.manifoldcf:mcf-api-service</include>
        <include>org.apache.manifoldcf:mcf-authority-service</include>
        <include>org.apache.manifoldcf:mcf-crawler-ui</include>
        <include>org.apache.manifoldcf:mcf-combined-service</include>
      </includes>
      <binaries>
        <outputDirectory>web/war</outputDirectory>
        <unpack>false</unpack>
        <includeDependencies>false</includeDependencies>
        <outputFileNameMapping>${artifact.artifactId}.${artifact.extension}</outputFileNameMapping>
      </binaries>
    </moduleSet>

    <moduleSet>
      <useAllReactorProjects>true</useAllReactorProjects>
      <includes>
        <include>org.apache.manifoldcf:mcf-spring-boot-app</include>
      </includes>
      <binaries>
        <outputDirectory>spring-boot-app</outputDirectory>
        <unpack>false</unpack>
        <includeDependencies>false</includeDependencies>
        <outputFileNameMapping>${artifact.artifactId}.${artifact.extension}</outputFileNameMapping>
      </binaries>
    </moduleSet>
  </moduleSets>

  <dependencySets>
    <dependencySet>
      <outputDirectory>lib</outputDirectory>
      <useProjectArtifact>false</useProjectArtifact>
      <useTransitiveDependencies>true</useTransitiveDependencies>
      <excludes>
